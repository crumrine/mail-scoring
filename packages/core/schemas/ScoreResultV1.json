{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mail-scoring:ScoreResultV1",
  "title": "ScoreResultV1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "engineVersion": {
      "const": "0.1.0"
    },
    "ruleSetVersion": {
      "const": "rules-1"
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "unavailable"
      ]
    },
    "heuristicScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spam": {
          "enum": [
            "present",
            "unknown"
          ]
        },
        "phishing": {
          "enum": [
            "present",
            "unknown"
          ]
        },
        "marketing": {
          "enum": [
            "present",
            "unknown"
          ]
        }
      },
      "required": [
        "spam",
        "phishing",
        "marketing"
      ]
    },
    "reasons": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "const": "auth_failed"
              },
              "contribution": {
                "type": "integer",
                "minimum": 0,
                "maximum": 20
              },
              "reason": {
                "const": "Verified transport evidence reports authentication failure."
              }
            },
            "required": [
              "id",
              "contribution",
              "reason"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "const": "link_mismatch"
              },
              "contribution": {
                "type": "integer",
                "minimum": 0,
                "maximum": 30
              },
              "reason": {
                "const": "A visible URL names a different host from its target."
              }
            },
            "required": [
              "id",
              "contribution",
              "reason"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "const": "link_userinfo"
              },
              "contribution": {
                "type": "integer",
                "minimum": 0,
                "maximum": 15
              },
              "reason": {
                "const": "An HTTP link contains user information before its host."
              }
            },
            "required": [
              "id",
              "contribution",
              "reason"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "const": "reply_to_mismatch"
              },
              "contribution": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              },
              "reason": {
                "const": "The supplied reply address differs from the sender host."
              }
            },
            "required": [
              "id",
              "contribution",
              "reason"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "const": "display_identity_mismatch"
              },
              "contribution": {
                "type": "integer",
                "minimum": 0,
                "maximum": 15
              },
              "reason": {
                "const": "The display identity names a different sender host."
              }
            },
            "required": [
              "id",
              "contribution",
              "reason"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "const": "impersonation_combined"
              },
              "contribution": {
                "type": "integer",
                "minimum": 0,
                "maximum": 15
              },
              "reason": {
                "const": "An authority claim accompanies independent suspicious evidence."
              }
            },
            "required": [
              "id",
              "contribution",
              "reason"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "const": "sensitive_request_combined"
              },
              "contribution": {
                "type": "integer",
                "minimum": 0,
                "maximum": 25
              },
              "reason": {
                "const": "A sensitive request accompanies suspicious link or identity evidence."
              }
            },
            "required": [
              "id",
              "contribution",
              "reason"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "const": "sender_blocked"
              },
              "contribution": {
                "type": "integer",
                "minimum": 0,
                "maximum": 40
              },
              "reason": {
                "const": "An explicit verified sender block preference was supplied."
              }
            },
            "required": [
              "id",
              "contribution",
              "reason"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "const": "sender_allowed"
              },
              "contribution": {
                "type": "integer",
                "minimum": 0,
                "maximum": 0
              },
              "reason": {
                "const": "An explicit verified address allow preference was supplied; other evidence remains."
              }
            },
            "required": [
              "id",
              "contribution",
              "reason"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "const": "marketing_headers"
              },
              "contribution": {
                "type": "integer",
                "minimum": 0,
                "maximum": 0
              },
              "reason": {
                "const": "The message declares mailing-list or bulk characteristics."
              }
            },
            "required": [
              "id",
              "contribution",
              "reason"
            ]
          }
        ]
      }
    },
    "limitsHit": {
      "type": "array",
      "maxItems": 19,
      "uniqueItems": true,
      "items": {
        "enum": [
          "source_bytes",
          "extracted_bytes",
          "header_bytes",
          "header_count",
          "header_field_bytes",
          "url_count",
          "attachment_count",
          "field_bytes",
          "duplicate_header",
          "control_chars",
          "source_incomplete",
          "html_uninspected",
          "auth_unknown",
          "preferences_unknown",
          "normalized_bytes",
          "url_decode_limit",
          "url_uninspected",
          "quoted_content",
          "identity_uninspected"
        ]
      }
    },
    "error": {
      "enum": [
        null,
        "invalid_input",
        "request_limit",
        "invalid_json"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "engineVersion",
    "ruleSetVersion",
    "status",
    "heuristicScore",
    "signals",
    "reasons",
    "limitsHit",
    "error"
  ],
  "x-maxUtf8Bytes": 4096
}
